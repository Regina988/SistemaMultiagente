# Normaliza fin de línea: en el repo siempre LF, cada OS convierte al hacer checkout
* text=auto

# Código y archivos YAML de Unity: siempre LF (evita diffs falsos Mac <-> Windows)
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.json      text eol=lf
*.asmdef    text eol=lf
*.py        text eol=lf
*.md        text eol=lf

*.meta          text eol=lf
*.unity         text eol=lf merge=unityyamlmerge
*.prefab        text eol=lf merge=unityyamlmerge
*.asset         text eol=lf merge=unityyamlmerge
*.mat           text eol=lf merge=unityyamlmerge
*.anim          text eol=lf merge=unityyamlmerge
*.controller    text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.mask          text eol=lf merge=unityyamlmerge
*.playable      text eol=lf merge=unityyamlmerge
*.lighting      text eol=lf merge=unityyamlmerge

# Binarios: no tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.tif  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.pdf  binary
*.zip  binary
